package rs.ac.bg.etf.pp1;

import java_cup.runtime.*;
import org.apache.log4j.*;
import rs.ac.bg.etf.pp1.ast.*;

parser code {:

	boolean errorDetected;

	Logger log = Logger.getLogger(getClass());
   
   
    // slede redefinisani metodi za prijavu gresaka radi izmene teksta poruke
     
    public void report_fatal_error(String message, Object info) throws java.lang.Exception {
      done_parsing();
      report_error(message, info);
    }
  
    public void syntax_error(Symbol cur_token) {
        report_error("\nSintaksna greska", cur_token);
    }
  
    public void unrecovered_syntax_error(Symbol cur_token) throws java.lang.Exception {
        report_fatal_error("Fatalna greska, parsiranje se ne moze nastaviti", cur_token);
    }

    public void report_error(String message, Object info) {
    	errorDetected = true;
    	StringBuilder msg = new StringBuilder(message); 
    	if (info instanceof Symbol)
            msg.append (" na liniji ").append(((Symbol)info).left);
        log.error(msg.toString());
    }


:}

init with {:
	errorDetected = false;
:}


scan with {:
	Symbol s = this.getScanner().next_token();
	if (s != null && s.value != null) 
		log.info(s.toString() + " " + s.value.toString());
	return s;
:}
								
terminal PROG, LBRACE, RBRACE, CONST, EQUAL, SEMI, COMMA, LBRACKET, RBRACKET, LPAREN, RPAREN, VOID, READ, PRINT, RETURN, INC, DEC, UNION;
terminal PLUS, MINUS, MUL, DIV, MOD, NEW;
terminal String IDENT;
terminal Integer NUMBER;
terminal Character CHAR;
terminal Boolean BOOL;

nonterminal DeclList DeclList;
nonterminal MethodDeclList MethodDeclList;
nonterminal ConstDecl ConstDecl;
nonterminal VarDecl VarDecl;
nonterminal OneConstDecl OneConstDecl;
nonterminal ConstDeclList ConstDeclList;
nonterminal OneVarDecl OneVarDecl;
nonterminal VarDeclList VarDeclList;
nonterminal MethodVarDeclList MethodVarDeclList;
nonterminal StatementList StatementList;
nonterminal FormPars FormPars;
nonterminal OneFormPar OneFormPar;
nonterminal FormParsList FormParsList;
nonterminal Statement Statement;
nonterminal PrintWithNum PrintWithNum;
nonterminal ReturnWithExpr ReturnWithExpr;
nonterminal Setop Setop;
nonterminal ActPars ActPars;
nonterminal ActParsYesOrNo ActParsYesOrNo;
nonterminal OneActPars OneActPars;
nonterminal ActParsList ActParsList;
nonterminal Addop Addop;
nonterminal Mulop Mulop;
nonterminal FactorActPars FactorActPars;

nonterminal rs.etf.pp1.symboltable.concepts.Obj ProgramName, Program, MethodDecl, MethodSignature, Designator, DesignatorStatement, DesignatorArrayName;
nonterminal rs.etf.pp1.symboltable.concepts.Struct Type, Expr, Term, Factor, FactorList, TermList, FactorSign;

Program ::= (Program) PROG ProgramName:P1 DeclList:D2 LBRACE MethodDecl:M3 RBRACE {: RESULT=new Program(P1, D2, M3); RESULT.setLine(P1left); :};

ProgramName ::= (ProgramName) IDENT:I1 {: RESULT=new ProgramName(I1); RESULT.setLine(I1left); :};


Type ::= (Type) IDENT:I1 {: RESULT=new Type(I1); RESULT.setLine(I1left); :};

DeclList ::= (DeclListConst) DeclList:D1 ConstDecl:C2 {: RESULT=new DeclListConst(D1, C2); RESULT.setLine(D1left); :}
			 |
			 (DeclListVar) DeclList:D1 VarDecl:V2 {: RESULT=new DeclListVar(D1, V2); RESULT.setLine(D1left); :}
			 |
			 (DeclListE) {: RESULT=new DeclListE(); :} /*epsilon*/
			 |
			 (DeclListError) error:e1
			 {: parser.report_error("Izvrsen oporavak od greske do , ili ; na liniji " + e1left , null); :} {: RESULT=new DeclListError(); :}
						
			 ;

ConstDecl ::= (ConstDecl) CONST Type:T1 OneConstDecl:O2 ConstDeclList:C3 SEMI {: RESULT=new ConstDecl(T1, O2, C3); RESULT.setLine(T1left); :};

OneConstDecl ::= (OneConstDeclNumber) IDENT:I1 EQUAL NUMBER:N2 {: RESULT=new OneConstDeclNumber(I1, N2); RESULT.setLine(I1left); :}
				|
				 (OneConstDeclChar) IDENT:I1 EQUAL CHAR:C2 {: RESULT=new OneConstDeclChar(I1, C2); RESULT.setLine(I1left); :}
				|
				 (OneConstDeclBool) IDENT:I1 EQUAL BOOL:B2 {: RESULT=new OneConstDeclBool(I1, B2); RESULT.setLine(I1left); :}
				;

ConstDeclList ::= (ConstDeclListAdd) COMMA OneConstDecl:O1 ConstDeclList:C2 {: RESULT=new ConstDeclListAdd(O1, C2); RESULT.setLine(O1left); :}
				 |
				  (ConstDeclListEnd) {: RESULT=new ConstDeclListEnd(); :}
				 ;
			

VarDecl ::= (VarDecl) Type:T1 OneVarDecl:O2 VarDeclList:V3 SEMI {: RESULT=new VarDecl(T1, O2, V3); RESULT.setLine(T1left); :};		   			   

OneVarDecl ::= (OneVarDeclOneD) IDENT:I1 {: RESULT=new OneVarDeclOneD(I1); RESULT.setLine(I1left); :} 
			   | 
			   (OneVarDeclArray) IDENT:I1 LBRACKET RBRACKET {: RESULT=new OneVarDeclArray(I1); RESULT.setLine(I1left); :}
			   |
			   (OneVarDeclError) error:e2
			   {: parser.report_error("Izvrsen oporavak od greske do , ili ; na liniji " + e2left , null); :} {: RESULT=new OneVarDeclError(); :}
			   ;		   			   

VarDeclList ::= (VarDeclListAdd) COMMA OneVarDecl:O1 VarDeclList:V2 {: RESULT=new VarDeclListAdd(O1, V2); RESULT.setLine(O1left); :}
				|
				(VarDeclListEnd) {: RESULT=new VarDeclListEnd(); :}
			    ;
			   
MethodDecl ::= (MethodDecl) MethodSignature:M1 MethodVarDeclList:M2 LBRACE StatementList:S3 RBRACE {: RESULT=new MethodDecl(M1, M2, S3); RESULT.setLine(M1left); :};

MethodSignature ::= (MethodSignature) VOID IDENT:I1 LPAREN FormPars:F2 RPAREN {: RESULT=new MethodSignature(I1, F2); RESULT.setLine(I1left); :}
					;

FormPars ::= (FormParsNotEmpty)  OneFormPar:O1 FormParsList:F2 {: RESULT=new FormParsNotEmpty(O1, F2); RESULT.setLine(O1left); :}
			 |
			 (FormParsEmpty) {: RESULT=new FormParsEmpty(); :}
			 ;

OneFormPar ::= (OneFormParOneD) Type:T1 IDENT:I2 {: RESULT=new OneFormParOneD(T1, I2); RESULT.setLine(T1left); :}
			   |
			   (OneFormParArray) Type:T1 IDENT:I2 LBRACKET RBRACKET {: RESULT=new OneFormParArray(T1, I2); RESULT.setLine(T1left); :}
			   ;

FormParsList ::= (FormParsListAdd) COMMA OneFormPar:O1 FormParsList:F2 {: RESULT=new FormParsListAdd(O1, F2); RESULT.setLine(O1left); :}
				 |
				 (FormParsListEnd) {: RESULT=new FormParsListEnd(); :}
			 	 ;
			 	 
MethodVarDeclList ::= (MethodVarDeclListNotEmpty) MethodVarDeclList:M1 VarDecl:V2 {: RESULT=new MethodVarDeclListNotEmpty(M1, V2); RESULT.setLine(M1left); :}
				 	  |
				 	  (MethodVarDeclListEmpty) {: RESULT=new MethodVarDeclListEmpty(); :} 			 	 
			   	 	  ;
			   	 

StatementList ::= (StatementListAdd) StatementList:S1 Statement:S2 {: RESULT=new StatementListAdd(S1, S2); RESULT.setLine(S1left); :}
				  |
				  (StatementListNotEnd) {: RESULT=new StatementListNotEnd(); :}   			   	 		   	 
			   	  ;
			   	 
Statement ::= (StatementDesignatorStatement) DesignatorStatement:D1 SEMI {: RESULT=new StatementDesignatorStatement(D1); RESULT.setLine(D1left); :}  
			  |
			  (StatementRead) READ LPAREN Designator:D1 RPAREN SEMI {: RESULT=new StatementRead(D1); RESULT.setLine(D1left); :}
			  |
			  (StatementPrintNumNo) PRINT LPAREN Expr:E1  RPAREN SEMI {: RESULT=new StatementPrintNumNo(E1); RESULT.setLine(E1left); :}
			  |
			  (StatementPrintNumYes) PRINT LPAREN Expr:E1 COMMA NUMBER:N2 RPAREN SEMI {: RESULT=new StatementPrintNumYes(E1, N2); RESULT.setLine(E1left); :}
			  |
			  (StatementReturn) RETURN ReturnWithExpr:R1 SEMI {: RESULT=new StatementReturn(R1); RESULT.setLine(R1left); :} 
			  |
			  (StatementAnotherStatement) LBRACE Statement:S1 RBRACE {: RESULT=new StatementAnotherStatement(S1); RESULT.setLine(S1left); :}
			  ;



ReturnWithExpr ::= (ReturnWithExprYes) Expr:E1 {: RESULT=new ReturnWithExprYes(E1); RESULT.setLine(E1left); :}
				   |
				   (ReturnWithExprNO) {: RESULT=new ReturnWithExprNO(); :}
				   ;
				   
DesignatorStatement ::= (DesignatorStatementAssign) Designator:D1 EQUAL Expr:E2 {: RESULT=new DesignatorStatementAssign(D1, E2); RESULT.setLine(D1left); :}
						|
						(DesignatorStatementError) error:e3
			  			{: parser.report_error("Izvrsen oporavak od greske do ; na liniji " + e3left, null); :} {: RESULT=new DesignatorStatementError(); :}
			  			|
						(DesignatorStatementSetOpAssign) Designator:D1 EQUAL Designator:D2 Setop:S3 Designator:D4 {: RESULT=new DesignatorStatementSetOpAssign(D1, D2, S3, D4); RESULT.setLine(D1left); :}
						|
						(DesignatorStatementInc) Designator:D1 INC {: RESULT=new DesignatorStatementInc(D1); RESULT.setLine(D1left); :}
						|
						(DesignatorStatementDec) Designator:D1 DEC {: RESULT=new DesignatorStatementDec(D1); RESULT.setLine(D1left); :}
						|
						(DesignatorStatementCallFunc) Designator:D1 LPAREN ActParsYesOrNo:A2 RPAREN {: RESULT=new DesignatorStatementCallFunc(D1, A2); RESULT.setLine(D1left); :}
						;

Expr ::= (Expr) TermList:T1 {: RESULT=new Expr(T1); RESULT.setLine(T1left); :}
		 ;
		 		 
TermList ::= (TermListAdd) TermList:T1 Addop:A2 Term:T3 {: RESULT=new TermListAdd(T1, A2, T3); RESULT.setLine(T1left); :} 
			 |
			 (TermListEnd) Term:T1 {: RESULT=new TermListEnd(T1); RESULT.setLine(T1left); :} 
			 ;
			 
Term ::= (Term) FactorList:F1 {: RESULT=new Term(F1); RESULT.setLine(F1left); :};

FactorList ::= (FactorListAdd) FactorList:F1 Mulop:M2 FactorSign:F3 {: RESULT=new FactorListAdd(F1, M2, F3); RESULT.setLine(F1left); :}
			   |
			   (FactorListEnd) FactorSign:F1 {: RESULT=new FactorListEnd(F1); RESULT.setLine(F1left); :}
			   ;
FactorSign ::= (FactorSignPlus) Factor:F1 {: RESULT=new FactorSignPlus(F1); RESULT.setLine(F1left); :}
			   |
			   (FactorSignMinus) MINUS Factor:F1 {: RESULT=new FactorSignMinus(F1); RESULT.setLine(F1left); :}
			   ;

Factor ::= (FactorNum)  NUMBER:N1 {: RESULT=new FactorNum(N1); RESULT.setLine(N1left); :}
		   |
		   (FactorChar) CHAR:C1 {: RESULT=new FactorChar(C1); RESULT.setLine(C1left); :}
		   |
		   (FactorBool) BOOL:B1 {: RESULT=new FactorBool(B1); RESULT.setLine(B1left); :}
		   |
		   (FactorExpr) LPAREN Expr:E1 RPAREN {: RESULT=new FactorExpr(E1); RESULT.setLine(E1left); :}
		   |
		   (FactorDesignator) Designator:D1 FactorActPars:F2 {: RESULT=new FactorDesignator(D1, F2); RESULT.setLine(D1left); :}
		   |
		   (FactorNew) NEW Type:T1 LBRACKET Expr:E2 RBRACKET {: RESULT=new FactorNew(T1, E2); RESULT.setLine(T1left); :}
		   ;		 

FactorActPars ::= (FactorActParsYes) LPAREN ActParsYesOrNo:A1 RPAREN {: RESULT=new FactorActParsYes(A1); RESULT.setLine(A1left); :}
				  |
				  (FactorActParsNo) {: RESULT=new FactorActParsNo(); :}
				  ;

ActParsYesOrNo ::= (ActParsYes) ActPars:A1 {: RESULT=new ActParsYes(A1); RESULT.setLine(A1left); :}
				   |
				   (ActParsNo) {: RESULT=new ActParsNo(); :}						
				   ;

ActPars ::= (ActPars) OneActPars:O1 ActParsList:A2 {: RESULT=new ActPars(O1, A2); RESULT.setLine(O1left); :};

OneActPars ::= (OneActPars) Expr:E1 {: RESULT=new OneActPars(E1); RESULT.setLine(E1left); :};

ActParsList ::= (ActParsListAdd) COMMA OneActPars:O1 ActParsList:A2 {: RESULT=new ActParsListAdd(O1, A2); RESULT.setLine(O1left); :}
				|
				(ActParsListEnd) {: RESULT=new ActParsListEnd(); :}
				;
				
Designator ::= (DesignatorCasual) IDENT:I1 {: RESULT=new DesignatorCasual(I1); RESULT.setLine(I1left); :}
			   |
			   (DesignatorArray) DesignatorArrayName:D1 LBRACKET Expr:E2 RBRACKET {: RESULT=new DesignatorArray(D1, E2); RESULT.setLine(D1left); :}
			   ;
DesignatorArrayName ::= (DesignatorArrayName) IDENT:I1 {: RESULT=new DesignatorArrayName(I1); RESULT.setLine(I1left); :};

Setop ::= (Setop) UNION {: RESULT=new Setop(); :};

Addop ::= (AddopPlus) PLUS {: RESULT=new AddopPlus(); :}
		  |
		  (AddopMinus) MINUS {: RESULT=new AddopMinus(); :}
		  ;
		 
Mulop ::= (MulopMul) MUL {: RESULT=new MulopMul(); :}
		  |
		  (MulopDiv) DIV {: RESULT=new MulopDiv(); :}
		  |
		  (MulopMod) MOD {: RESULT=new MulopMod(); :}
		  ;		 
























  	 
	