package rs.ac.bg.etf.pp1;

import java_cup.runtime.*;
import org.apache.log4j.*;
import rs.ac.bg.etf.pp1.ast.*;

parser code {:

	boolean errorDetected;

	Logger log = Logger.getLogger(getClass());
   
   
    // slede redefinisani metodi za prijavu gresaka radi izmene teksta poruke
     
    public void report_fatal_error(String message, Object info) throws java.lang.Exception {
      done_parsing();
      report_error(message, info);
    }
  
    public void syntax_error(Symbol cur_token) {
        report_error("\nSintaksna greska", cur_token);
    }
  
    public void unrecovered_syntax_error(Symbol cur_token) throws java.lang.Exception {
        report_fatal_error("Fatalna greska, parsiranje se ne moze nastaviti", cur_token);
    }

    public void report_error(String message, Object info) {
    	errorDetected = true;
    	StringBuilder msg = new StringBuilder(message); 
    	if (info instanceof Symbol)
            msg.append (" na liniji ").append(((Symbol)info).left);
        log.error(msg.toString());
    }


:}

init with {:
	errorDetected = false;
:}


scan with {:
	Symbol s = this.getScanner().next_token();
	if (s != null && s.value != null) 
		log.info(s.toString() + " " + s.value.toString());
	return s;
:}
								
terminal PROG, LBRACE, RBRACE, CONST, EQUAL, SEMI, COMMA, LBRACKET, RBRACKET, LPAREN, RPAREN, VOID, READ, PRINT, RETURN, INC, DEC, UNION;
terminal PLUS, MINUS, MUL, DIV, MOD, NEW;
terminal String IDENT;
terminal Integer NUMBER;
terminal Character CHAR;
terminal Boolean BOOL;

nonterminal DeclList, MethodDeclList, ConstDecl, VarDecl, OneConstDecl, ConstDeclList, OneVarDecl, VarDeclList;
nonterminal MethodVarDeclList, StatementList, FormPars, OneFormPar, FormParsList, Statement;
nonterminal PrintWithNum, ReturnWithExpr, Setop, ActPars, ActParsYesOrNo, OneActPars, ActParsList, Addop, Mulop;
nonterminal FactorActPars;

nonterminal rs.etf.pp1.symboltable.concepts.Obj ProgramName, Program, MethodDecl, MethodSignature, Designator, DesignatorStatement, DesignatorArrayName;
nonterminal rs.etf.pp1.symboltable.concepts.Struct Type, Expr, Term, Factor, FactorList, TermList, FactorSign;

Program ::= (Program) PROG ProgramName DeclList LBRACE MethodDecl RBRACE;

ProgramName ::= (ProgramName) IDENT;


Type ::= (Type) IDENT;

DeclList ::= (DeclListConst) DeclList ConstDecl
			 |
			 (DeclListVar) DeclList VarDecl
			 |
			 (DeclListE) /*epsilon*/
			 |
			 (DeclListError) error:e1
			 {: parser.report_error("Izvrsen oporavak od greske do , ili ; na liniji " + e1left , null); :}
						
			 ;

ConstDecl ::= (ConstDecl) CONST Type OneConstDecl ConstDeclList SEMI;

OneConstDecl ::= (OneConstDeclNumber) IDENT EQUAL NUMBER
				|
				 (OneConstDeclChar) IDENT EQUAL CHAR
				|
				 (OneConstDeclBool) IDENT EQUAL BOOL
				;

ConstDeclList ::= (ConstDeclListAdd) COMMA OneConstDecl ConstDeclList
				 |
				  (ConstDeclListEnd)
				 ;
			

VarDecl ::= (VarDecl) Type OneVarDecl VarDeclList SEMI;		   			   

OneVarDecl ::= (OneVarDeclOneD) IDENT 
			   | 
			   (OneVarDeclArray) IDENT LBRACKET RBRACKET
			   |
			   (OneVarDeclError) error:e2
			   {: parser.report_error("Izvrsen oporavak od greske do , ili ; na liniji " + e2left , null); :}
			   ;		   			   

VarDeclList ::= (VarDeclListAdd) COMMA OneVarDecl VarDeclList
				|
				(VarDeclListEnd)
			    ;
			   
MethodDecl ::= (MethodDecl) MethodSignature MethodVarDeclList LBRACE StatementList RBRACE;

MethodSignature ::= (MethodSignature) VOID IDENT LPAREN FormPars RPAREN
					;

FormPars ::= (FormParsNotEmpty)  OneFormPar FormParsList
			 |
			 (FormParsEmpty)
			 ;

OneFormPar ::= (OneFormParOneD) Type IDENT
			   |
			   (OneFormParArray) Type IDENT LBRACKET RBRACKET
			   ;

FormParsList ::= (FormParsListAdd) COMMA OneFormPar FormParsList
				 |
				 (FormParsListEnd)
			 	 ;
			 	 
MethodVarDeclList ::= (MethodVarDeclListNotEmpty) MethodVarDeclList VarDecl
				 	  |
				 	  (MethodVarDeclListEmpty) 			 	 
			   	 	  ;
			   	 

StatementList ::= (StatementListAdd) StatementList Statement
				  |
				  (StatementListNotEnd)   			   	 		   	 
			   	  ;
			   	 
Statement ::= (StatementDesignatorStatement) DesignatorStatement SEMI  
			  |
			  (StatementRead) READ LPAREN Designator RPAREN SEMI
			  |
			  (StatementPrintNumNo) PRINT LPAREN Expr  RPAREN SEMI
			  |
			  (StatementPrintNumYes) PRINT LPAREN Expr COMMA NUMBER RPAREN SEMI
			  |
			  (StatementReturn) RETURN ReturnWithExpr SEMI 
			  |
			  (StatementAnotherStatement) LBRACE Statement RBRACE
			  ;



ReturnWithExpr ::= (ReturnWithExprYes) Expr
				   |
				   (ReturnWithExprNO)
				   ;
				   
DesignatorStatement ::= (DesignatorStatementAssign) Designator EQUAL Expr
						|
						(DesignatorStatementError) error:e3
			  			{: parser.report_error("Izvrsen oporavak od greske do ; na liniji " + e3left, null); :}
			  			|
						(DesignatorStatementSetOpAssign) Designator EQUAL Designator Setop Designator
						|
						(DesignatorStatementInc) Designator INC
						|
						(DesignatorStatementDec) Designator DEC
						|
						(DesignatorStatementCallFunc) Designator LPAREN ActParsYesOrNo RPAREN
						;

Expr ::= (Expr) TermList
		 ;
		 		 
TermList ::= (TermListAdd) TermList Addop Term 
			 |
			 (TermListEnd) Term 
			 ;
			 
Term ::= (Term) FactorList;

FactorList ::= (FactorListAdd) FactorList Mulop FactorSign
			   |
			   (FactorListEnd) FactorSign
			   ;
FactorSign ::= (FactorSignPlus) Factor
			   |
			   (FactorSignMinus) MINUS Factor
			   ;

Factor ::= (FactorNum)  NUMBER
		   |
		   (FactorChar) CHAR
		   |
		   (FactorBool) BOOL
		   |
		   (FactorExpr) LPAREN Expr RPAREN
		   |
		   (FactorDesignator) Designator FactorActPars
		   |
		   (FactorNew) NEW Type LBRACKET Expr RBRACKET
		   ;		 

FactorActPars ::= (FactorActParsYes) LPAREN ActParsYesOrNo RPAREN
				  |
				  (FactorActParsNo)
				  ;

ActParsYesOrNo ::= (ActParsYes) ActPars
				   |
				   (ActParsNo)						
				   ;

ActPars ::= (ActPars) OneActPars ActParsList;

OneActPars ::= (OneActPars) Expr;

ActParsList ::= (ActParsListAdd) COMMA OneActPars ActParsList
				|
				(ActParsListEnd)
				;
				
Designator ::= (DesignatorCasual) IDENT
			   |
			   (DesignatorArray) DesignatorArrayName LBRACKET Expr RBRACKET
			   ;
DesignatorArrayName ::= (DesignatorArrayName) IDENT;

Setop ::= (Setop) UNION;

Addop ::= (AddopPlus) PLUS
		  |
		  (AddopMinus) MINUS
		  ;
		 
Mulop ::= (MulopMul) MUL
		  |
		  (MulopDiv) DIV
		  |
		  (MulopMod) MOD
		  ;		 
























  	 
	